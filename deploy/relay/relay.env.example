# /etc/relay/relay.env  (root:root 0600; read by systemd, not by the relay user)

# The relay's own domain. Phones connect to <hostid>.<domain>:443, daemons to
# https://<domain>. DNS needs A/AAAA for both the apex and *.<domain>.
RELAY_DOMAIN=relay.example.com

# Optional contact for Let's Encrypt. LE no longer sends expiry mail; use an
# external monitor for certificate expiry instead.
RELAY_ACME_EMAIL=

# First bring-up: use the staging directory so mistakes do not burn the
# production rate limit (5 duplicate certificates per week). Remove the line
# and restart once https://<domain>/healthz works with a staging certificate.
#RELAY_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# Loopback metrics, pprof, and health: curl -s localhost:9100/debug/vars
RELAY_METRICS_LISTEN=127.0.0.1:9100

# Extra flags for the smoke test, e.g. "--dev" for a self-signed apex cert or
# "-v" for debug logging. Leave empty in production.
RELAY_FLAGS=
